super + b
  firefox

super + F9
  mnt

super + F10
  umt

super + BackSpace
  rofi -modi "power-menu:rofi-power-menu" -show power-menu -theme "themes/powermenu"

super + f
  thunar

super + Return
  kitty || uxterm

super + c
  galculator

super + shift + x
  loginctl lock-session

super + Escape
  rofi -modi run,drun -show drun -show-icons -display-run "Launch" -display-drun "Launch"
  
# Menu
#   rofi -modi run,drun -show drun -show-icons -display-run "Launch" -display-drun "Launch"

alt + Tab
  rofiwindow

XF86AudioNext
  playerctl next

XF86AudioPrev
  playerctl previous

XF86AudioPlay
  playerctl play-pause

XF86AudioRaiseVolume
  wpctl set-volume -l 1.2 @DEFAULT_AUDIO_SINK@ 5%+

XF86AudioLowerVolume
  wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-

XF86AudioMute
  wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

XF86AudioMicMute
  wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

XF86MonBrightnessUp
  brightnessctl -q -d intel_backlight set +5%

XF86MonBrightnessDown
  brightnessctl -q -d intel_backlight set 5%-

Print
  flameshot gui
